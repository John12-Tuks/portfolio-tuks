@{
    ViewData["Title"] = "About Page";
}

<link rel="stylesheet" href="~/css/index.css" /> 

<div class="text-center">
    <h1 class="display-4">About me</h1>
</div>

<div class="container mt-4">
    <div class="row align-items-center">
        <div class="col-md-6 text-center">
            <div class="logo-circle mx-auto">
                <img src="~/images/logo/pastorimg.jpeg" alt="Tokelo Kgomo">
            </div>
            <h4>Tokelo Kgomo</h4>
            <p><i>I am passionate about building and Securing Systems!</i></p>
        </div>

        <div class="col-md-6">
            <h3>Hello</h3>
            <h3>My Name is</h3>
            <h3 class="purple-text">Tokelo Kgomo</h3>

            <p style="text-align: justify"> 
                I am a Computer Science student who wants to be a Software Developer/Engineer and is curious about ethical hacking. 
                I have a strong desire for building systems and securing them.
            </p>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h1 class="project-heading text-center">My <strong class="purple">SkillSet</strong></h1>
    <div class="row d-flex justify-content-center" style="padding-bottom: 50px;">
        
        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Java.svg" alt="Java" />
            <div class="tech-icons-text">Java</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Javascript.svg" alt="javascript" />
            <div class="tech-icons-text">Javascript</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Typescript.svg" alt="typescript" />
            <div class="tech-icons-text">Typescript</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/c#.svg" alt="C#" />
            <div class="tech-icons-text">C#</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Node.svg" alt="node" />
            <div class="tech-icons-text">Node.Js</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Docker.svg" alt="docker" />
            <div class="tech-icons-text">Docker</div>
        </div>
    </div>

    <h1 class="project-heading text-center">Tools I <strong class="purple">Use</strong></h1>
    <div class="row d-flex justify-content-center" style="padding-bottom: 50px;">
        
        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/Apple MacOSX.svg" alt="macOs" />
            <div class="tech-icons-text">Mac Os</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/vscode.svg" alt="vsCode" />
            <div class="tech-icons-text">VS Code</div>
        </div>

        <div class="col-4 col-md-2 tech-icons">
            <img src="~/assets/tech-icons/intellij-idea.svg" alt="IntelliJ" />
            <div class="tech-icons-text">IntelliJ</div>
        </div>
    </div>
</div>